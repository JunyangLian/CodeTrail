# GenomeQC Agent environment template - variable NAMES only, no real credentials.
# Copy to .env and fill locally; .env is git-ignored and must never be committed.

# Model gateway (offline stages MUST stay on fake/mock provider)
GENOMEQC_MODEL_PROVIDER=fake            # fake | glm | deepseek
GENOMEQC_MODEL_ID=fake-planner-v0
GENOMEQC_API_KEY=                       # only needed for real providers; never commit
GENOMEQC_API_BASE=                      # provider base URL if non-default

# Budget ledger (V3-owned; never inherit V2 SESSION_CAPS)
GENOMEQC_MAX_MODEL_REQUESTS=50
GENOMEQC_MAX_TOOL_CALLS=200
GENOMEQC_MAX_COST_USD=0                 # 0 = offline/mock only

# Storage
GENOMEQC_DATA_DIR=./data                # packets, run state, reports (git-ignored)
GENOMEQC_DB_PATH=./data/genomeqc.sqlite3
