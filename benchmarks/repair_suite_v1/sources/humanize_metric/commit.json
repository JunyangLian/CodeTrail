inal_ = \"mμnpfazyrq\"[(-exponent - 1) // 3]\n     else:\n         ordinal_ = \"\"\n-    value_ = format(value, f\".{int(max(0, precision - exponent % 3 - 1))}f\")\n+    value_ = format(value, f\".{digits}f\")\n     if not (unit or ordinal_) or unit in (\"°\", \"′\", \"″\"):\n         space = \"\"\n     else:"},{"sha":"244dee0db3eb9d3997cc81e85ec0b5f39b2858d3","filename":"tests/test_number.py","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/python-humanize/humanize/blob/7574e0cc377d80db0d2756fc2c5e0b8799a6f8b4/tests%2Ftest_number.py","raw_url":"https://github.com/python-humanize/humanize/raw/7574e0cc377d80db0d2756fc2c5e0b8799a6f8b4/tests%2Ftest_number.py","contents_url":"https://api.github.com/repos/python-humanize/humanize/contents/tests%2Ftest_number.py?ref=7574e0cc377d80db0d2756fc2c5e0b8799a6f8b4","patch":"@@ -257,6 +257,10 @@ def test_clamp(test_args: list[typing.Any], expected: str) -> None:\n         ([1234.56], \"1.23 k\"),\n         ([12345, \"\", 6], \"12.3450 k\"),\n         ([200_000], \"200 k\"),\n+        ([999.9, \"V\"], \"1.00 kV\"),\n+        ([999.99, \"V\"], \"1.00 kV\"),\n+        ([999_999, \"V\"], \"1.00 MV\"),\n+        ([0.0009999, \"V\"], \"1.00 mV\"),\n         ([1e25, \"m\"], \"10.0 Ym\"),\n         ([1e26, \"m\"], \"100 Ym\"),\n         ([1e27, \"A\"], \"1.00 RA\"),"}]}