{"sha":"435774ef8b10c1355bf77483a837945034011754","node_id":"C_kwDOAH7Cv9oAKDQzNTc3NGVmOGIxMGMxMzU1YmY3NzQ4M2E4Mzc5NDUwMzQwMTE3NTQ","commit":{"author":{"name":"Mahmoud Hashemi","email":"mahmoud@hatnote.com","date":"2026-08-06T19:12:08Z"},"committer":{"name":"Mahmoud Hashemi","email":"mahmoud@hatnote.com","date":"2026-08-06T19:12:08Z"},"message":"strutils: make empty MultiReplace mapping a no-op\n\nMultiReplace({}) compiled an empty combined pattern, which matches\neverywhere with match.lastgroup None, so .sub() raised KeyError: None\non any input. An empty substitution map now leaves text unchanged;\ncombined_pattern stays a compiled pattern in all cases (no sentinel).","tree":{"sha":"a9751bfd679e9f1b6f6ef135a84b9c4d53fd3ffd","url":"https://api.github.com/repos/mahmoud/boltons/git/trees/a9751bfd679e9f1b6f6ef135a84b9c4d53fd3ffd"},"url":"https://api.github.com/repos/mahmoud/boltons/git/commits/435774ef8b10c1355bf77483a837945034011754","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/mahmoud/boltons/commits/435774ef8b10c1355bf77483a837945034011754","html_url":"https://github.com/mahmoud/boltons/commit/435774ef8b10c1355bf77483a837945034011754","comments_url":"https://api.github.com/repos/mahmoud/boltons/commits/435774ef8b10c1355bf77483a837945034011754/comments","author":{"login":"mahmoud","id":130193,"node_id":"MDQ6VXNlcjEzMDE5Mw==","avatar_url":"https://avatars.githubusercontent.com/u/130193?v=4","gravatar_id":"","url":"https://api.github.com/users/mahmoud","html_url":"https://github.com/mahmoud","followers_url":"https://api.github.com/users/mahmoud/followers","following_url":"https://api.github.com/users/mahmoud/following{/other_user}","gists_url":"https://api.github.com/users/mahmoud/gists{/gist_id}","starred_url":"https://api.github.com/users/mahmoud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mahmoud/subscriptions","organizations_url":"https://api.github.com/users/mahmoud/orgs","repos_url":"https://api.github.com/users/mahmoud/repos","events_url":"https://api.github.com/users/mahmoud/events{/privacy}","received_events_url":"https://api.github.com/users/mahmoud/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mahmoud","id":130193,"node_id":"MDQ6VXNlcjEzMDE5Mw==","avatar_url":"https://avatars.githubusercontent.com/u/130193?v=4","gravatar_id":"","url":"https://api.github.com/users/mahmoud","html_url":"https://github.com/mahmoud","followers_url":"https://api.github.com/users/mahmoud/followers","following_url":"https://api.github.com/users/mahmoud/following{/other_user}","gists_url":"https://api.github.com/users/mahmoud/gists{/gist_id}","starred_url":"https://api.github.com/users/mahmoud/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mahmoud/subscriptions","organizations_url":"https://api.github.com/users/mahmoud/orgs","repos_url":"https://api.github.com/users/mahmoud/repos","events_url":"https://api.github.com/users/mahmoud/events{/privacy}","received_events_url":"https://api.github.com/users/mahmoud/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0a3084e3058fd814684b1fc98343ec2e76d13ddc","url":"https://api.github.com/repos/mahmoud/boltons/commits/0a3084e3058fd814684b1fc98343ec2e76d13ddc","html_url":"https://github.com/mahmoud/boltons/commit/0a3084e3058fd814684b1fc98343ec2e76d13ddc"}],"stats":{"total":11,"additions":11,"deletions":0},"files":[{"sha":"10a1d5a904eefbad524f07defbbeadae8ca7494c","filename":"boltons/strutils.py","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/mahmoud/boltons/blob/435774ef8b10c1355bf77483a837945034011754/boltons%2Fstrutils.py","raw_url":"https://github.com/mahmoud/boltons/raw/435774ef8b10c1355bf77483a837945034011754/boltons%2Fstrutils.py","contents_url":"https://api.github.com/repos/mahmoud/boltons/contents/boltons%2Fstrutils.py?ref=435774ef8b10c1355bf77483a837945034011754","patch":"@@ -1230,6 +1230,8 @@ def sub(self, text):\n         Given an input string, run all substitutions given in the\n         constructor.\n         \"\"\"\n+        if not self.group_map:\n+            return text\n         return self.combined_pattern.sub(self._get_value, text)\n \n "},{"sha":"b1f22ce38be546b201a6fd8c52b64f484ebf265d","filename":"tests/test_strutils.py","status":"modified","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/mahmoud/boltons/blob/435774ef8b10c1355bf77483a837945034011754/tests%2Ftest_strutils.py","raw_url":"https://github.com/mahmoud/boltons/raw/435774ef8b10c1355bf77483a837945034011754/tests%2Ftest_strutils.py","contents_url":"https://api.github.com/repos/mahmoud/boltons/contents/tests%2Ftest_strutils.py?ref=435774ef8b10c1355bf77483a837945034011754","patch":"@@ -314,3 +314,12 @@ def test_pluralize_x():\n     assert pluralize('FOX') == 'FOXES'\n     # Irregular '-x' words are unaffected (handled before the rule).\n     assert pluralize('ox') == 'oxen'\n+\n+\n+\n+def test_multi_replace_empty_mapping():\n+    # An empty substitution map is a no-op; previously the empty combined\n+    # pattern matched everywhere with lastgroup None, raising KeyError.\n+    assert strutils.MultiReplace({}).sub('foo bar') == 'foo bar'\n+    assert strutils.MultiReplace([]).sub('foo bar') == 'foo bar'\n+    assert strutils.multi_replace('foo bar', {}) == 'foo bar'\n\\ No newline at end of file"}]}